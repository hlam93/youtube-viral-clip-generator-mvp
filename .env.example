# Required: YouTube Data API key for discovery/search
YOUTUBE_DATA_API_KEY=your_youtube_data_api_key_here

# Required: Hume API key for audio emotion scoring
HUME_API_KEY=your_hume_api_key_here

# Optional: transcript emotion provider key (if using external service)
TRANSCRIPT_EMOTION_API_KEY=your_transcript_emotion_api_key_here

# Optional: Mode B (rendered fallback) render source provider. "mock" is the only supported
# value -- there is no licensed/compliant way for this app to fetch YouTube video/audio bytes
# server-side yet (see src/renderProvider.ts). Leave unset in production: Mode B clips then
# degrade gracefully (omitted from the feed) instead of crashing the job.
# RENDER_SOURCE_PROVIDER=mock
