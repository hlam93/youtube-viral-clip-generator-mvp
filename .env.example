# Required: YouTube Data API key for discovery/search
YOUTUBE_DATA_API_KEY=your_youtube_data_api_key_here

# Required: Hume API key for audio emotion scoring
HUME_API_KEY=your_hume_api_key_here

# Optional: transcript emotion provider key (if using external service)
TRANSCRIPT_EMOTION_API_KEY=your_transcript_emotion_api_key_here
